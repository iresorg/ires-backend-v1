# =============================================================================
# iRES Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# Application Environment
# =============================================================================
NODE_ENV=development

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_database_password
DB_NAME=ires_db
DB_TYPE=postgres
DB_SSL=false

# =============================================================================
# JWT Authentication
# =============================================================================
# Secret keys for JWT token generation and verification
JWT_TOKEN_SECRET=your_jwt_secret_key_here_make_it_long_and_random
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_make_it_long_and_random

# =============================================================================
# Super Admin Default Configuration
# =============================================================================
# Default super admin account details for initial setup
# These will be used by the seeder script to create the first admin user
DEFAULT_SUPER_ADMIN_EMAIL=admin@ires.com
DEFAULT_SUPER_ADMIN_PASSWORD=SuperAdmin123!
DEFAULT_SUPER_ADMIN_FIRST_NAME=Super
DEFAULT_SUPER_ADMIN_LAST_NAME=Admin

# =============================================================================
# RabbitMQ Config
# =============================================================================
AMQP_URL=amqp://username:password@host:port

# =============================================================================
# Email (Postmark SMTP)
# Host: smtp.postmarkapp.com | Port: 587
# User + password: both set to your Postmark Server Token
# EMAIL_FROM must be a verified sender/domain in Postmark
# =============================================================================
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_USER=your_postmark_server_token
EMAIL_PASSWORD=your_postmark_server_token
EMAIL_FROM=techsupport@iresorg.com

# =============================================================================
# Token Encryption
# =============================================================================
# Generate this key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_32_byte_hex_string_here
WHITELISTED_ORIGINS=http://localhost:5173,https://iresorg.netlify.app

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
